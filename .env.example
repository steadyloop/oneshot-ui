# PostgreSQL database provisioned with the OneShot schema.
DATABASE_URL=postgresql:///oneshot
# Optional separate database for published job data.
JOBS_DATABASE_URL=

# Optional Google sign-in. Register the public URL + /api/auth/callback in Google.
ONESHOT_GOOGLE_CLIENT_ID=
ONESHOT_GOOGLE_CLIENT_SECRET=

# Set a stable random secret in production. Blank uses a temporary local secret.
ONESHOT_SESSION_SECRET=
ONESHOT_PUBLIC_URL=http://127.0.0.1:8766
# Use 1 when served over HTTPS.
ONESHOT_COOKIE_SECURE=0

# Optional Google-verified administrator email. Blank disables company editing.
ONESHOT_COMPANY_EDITOR_EMAIL=
